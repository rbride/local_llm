# Copy to bot.env and fill in. One setting per line; don't split values across lines.
# Every line here is also a plain environment variable, if you'd rather set it that way.

# ---- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Who may use the bot. Comma-separated user IDs, or * for anyone (careful: that
# also lets the bot be added to any group). Admins (below) are always allowed.
# People also get added automatically when they talk in a trusted group.
ALLOWED_USER_IDS=

# Admins can run every command (/allow, /persona, /fact, /rebase, /restart, ...),
# skip the rate limit, and their adding the bot to a group makes that group trusted.
# Find your own id by messaging the bot and sending /id. SET THIS, or no one can administer the bot.
ADMIN_USER_IDS=

# Groups that are trusted from the start (comma-separated chat IDs, usually negative).
# In a trusted group, everyone who sends a message is auto-added to the allow list.
# You normally don't need this: add the bot to a group yourself (as an admin) and
# it trusts that group automatically. Get a group's id with /id inside it.
TRUSTED_CHAT_IDS=

# In a trusted group, auto-allow anyone who talks (1) or keep the group members out (0).
ALLOW_GROUP_MEMBERS=1

# If a non-admin adds the bot to a group, leave it (1) or stay (0).
# Ignored when ALLOWED_USER_IDS=*.
LEAVE_UNTRUSTED_GROUPS=1

# Commands anyone allowed may run. Everything else is admin-only.
PUBLIC_COMMANDS=help,start,retry,stop,stats,id,tools

# Max messages per user per minute (0 = unlimited). Admins are exempt.
RATE_LIMIT_PER_MIN=8
MAX_QUEUE=20

# ---- Model server (llama-server) -------------------------------------------
LLM_URL=http://127.0.0.1:1234/v1/chat/completions
LLM_MODEL=local-model
SYSTEM_PROMPT=You are a helpful, funny assistant chatting over Telegram. Keep replies concise.
# Repeat the persona next to each new message so the model stays in character.
PERSONA_REMINDER=1
MAX_HISTORY=20
# Token budget per reply, thinking included. If it runs out while thinking,
# the bot retries once with thinking off (capped at RETRY_MAX_TOKENS).
MAX_TOKENS=6000
RETRY_MAX_TOKENS=2048
TEMPERATURE=0.7
# Default for new chats; each chat can change it with /think on|off.
THINKING=1
# Give up if the server sends nothing for this many seconds.
LLM_TIMEOUT=600

# ---- Live streaming ---------------------------------------------------------
STREAMING=1
# Private chats use Telegram's live drafts. Keep this >= 800 (Telegram limits: 20 per 5 s, 40 per 30 s).
DRAFT_INTERVAL_MS=900
# Groups stream by editing a message. Keep this >= 3000 or Telegram will throttle you.
EDIT_INTERVAL_MS=3500
# Show Telegram's stop button on streaming drafts.
STOP_BUTTON=1

# ---- Tools ------------------------------------------------------------------
# "all", "none", or a list: web_search,fetch_url,wikipedia,weather,calculator,roll_dice,random,get_datetime,look_up_facts
TOOLS=all
MAX_TOOL_ROUNDS=5
# Search engine, in order of preference. With neither set, DuckDuckGo is used
# (works without setup but may rate-limit you).
SEARXNG_URL=
BRAVE_API_KEY=
SEARCH_RESULTS=5
# Max characters of a web page handed to the model.
FETCH_MAX_CHARS=8000
# metric or imperial
WEATHER_UNITS=imperial
# Add a "🔧 web_search, weather" line under replies that used tools.
SHOW_TOOL_FOOTER=1

# ---- Facts (what the bot knows about people and chats) ----------------------
# A plain text file you can edit by hand; the bot reloads it when it changes.
# Admins also edit it with /fact, /unfact, and view it with /facts.
# Relevant facts are added to the prompt; the model can search the rest with look_up_facts.
FACTS_FILE=facts.txt
# How many characters of facts to put into each prompt.
FACTS_CONTEXT_CHARS=3000

# ---- Self-update (/rebase and /restart, admin-only) ------------------------
# /restart re-execs the bot. /rebase does: git fetch + rebase, rebuild, then restart.
# GIT_REPO_DIR defaults to the folder the binary is in. The rest default sensibly.
# WARNING: anyone who can push to this repo's branch can run code on this machine
# the next time an admin runs /rebase (it builds and launches whatever was pushed).
GIT_REPO_DIR=
GIT_REMOTE=origin
GIT_BRANCH=main
# Build step run after a successful rebase. Empty to skip building.
BUILD_COMMAND=make

# Where personas, /think settings, the allow list and trusted groups are saved.
STATE_FILE=state.json
