# Copy this file to bot.env and fill it in.

# From @BotFather
TELEGRAM_BOT_TOKEN=Insert_token_here

# Your Telegram user ID (comma-separate several). Leave blank at first:
# the bot will tell you your ID when you message it.
ALLOWED_USER_IDS=*

# LM Studio's local server
LLM_URL=http://127.0.0.1:1234/v1/chat/completions
# Paste the id from http://127.0.0.1:1234/v1/models
LLM_MODEL=qwen3.6-35b-a3b-uncensored-heretic

SYSTEM_PROMPT=
MAX_HISTORY=4000
MAX_TOKENS=20000
TEMPERATURE=0.7
LLM_TIMEOUT=600
